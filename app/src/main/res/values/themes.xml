<resources>
    <style name="Base.Theme.ProjetoDDM" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/elo_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/elo_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/elo_on_primary_container</item>
        <item name="colorSecondary">@color/elo_primary</item>
        <item name="android:colorBackground">@color/elo_background</item>
        <item name="colorSurface">@color/elo_surface</item>
        <item name="colorOnSurface">@color/elo_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/elo_on_surface_variant</item>
        <item name="colorOutline">@color/elo_outline</item>
        <item name="colorControlActivated">@color/elo_primary</item>
        <item name="actionMenuTextColor">@color/elo_primary</item>

        <item name="android:windowLightStatusBar">true</item>

        <item name="materialButtonStyle">@style/Widget.Elo.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Elo.Card</item>
        <item name="toolbarStyle">@style/Widget.Elo.Toolbar</item>
    </style>

    <style name="Theme.ProjetoDDM" parent="Base.Theme.ProjetoDDM" />

    <style name="Widget.Elo.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Elo.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">@color/elo_surface</item>
        <item name="boxStrokeColor">@color/elo_primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/elo_primary</item>
    </style>

    <style name="Widget.Elo.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/elo_surface</item>
        <item name="strokeColor">@color/elo_card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Elo.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/elo_background</item>
        <item name="titleTextAppearance">@style/TextAppearance.Elo.ToolbarTitle</item>
    </style>

    <style name="TextAppearance.Elo.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
    </style>
</resources>